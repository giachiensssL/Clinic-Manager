# =============================================
# CLINIC MANAGEMENT SYSTEM - Environment Config
# =============================================

# ---- Database Configuration (SQLite for local demo without Docker)
DATABASE_URL=sqlite+aiosqlite:///./clinic.db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=clinic_db
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Configuration ----
# Mode: mock | production
AI_MODE=mock

# LLM Provider: openai | gemini | claude | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Vector DB ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Security ----
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SECRET_KEY=your-app-secret-key-change-in-production

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Clinic AI
VITE_AI_MODE=mock
